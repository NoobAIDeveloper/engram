# engram KB gitignore

# SECRETS — source config can hold API tokens (Notion, Granola, GitHub).
# Never commit this file.
.engram/sources.json

# Sync state and Claude-generated cluster map (regenerable)
.engram/*-sync-meta.json
.engram/autosync.json
.engram/sync-meta.json
.engram/cluster-map.json.bak
.engram/ingest-state.json

# Obsidian workspace state (per-machine, don't share)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache

# OS junk
.DS_Store
Thumbs.db

# Editor junk
.vscode/
.idea/
*.swp
*.swo
*~

# Python cache (if user runs scripts in-tree)
__pycache__/
*.pyc

# By default, do NOT ignore the raw item stores or the cluster map itself —
# users may want to back them up via git. NOTE: raw/items.jsonl can contain
# your AI chat history and meeting notes; if this repo will ever be pushed
# somewhere shared, uncomment:
# raw/items.jsonl
# raw/bookmarks.jsonl
# raw/bookmarks/
# .engram/cluster-map.json
